# Lamka Hub Backend Environment Variables
PORT=5000
NODE_ENV=development

# Supabase Credentials (User will update with actual project credentials)
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Razorpay Payment Gateway Credentials (India UPI, Cards, Wallets)
RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# WhatsApp OTP Gateway Credentials (Meta Cloud API / Twilio WhatsApp)
WHATSAPP_MODE=development # development | production
WHATSAPP_API_TOKEN=your_meta_whatsapp_api_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id

# JWT Secret for Session Auth
JWT_SECRET=lamka_hub_super_secret_jwt_key_2026
